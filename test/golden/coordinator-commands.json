      },
      {
        "sdk": "commands.run",
        "cmd": "tmux capture-pane -t claude -p"
      },
      {
        "sdk": "getInfo",
        "id": "m_new"
      }
    ],
    "out": [
      "{\"name\":\"boss\",\"machine\":\"coord-boss\",\"remoteControlName\":\"boss\",\"attach\":\"npx --yes instabox@latest ssh coord-boss -- tmux attach -t claude\",\"started\":true}"
    ]
  },
  "ls": {
    "args": [
      "ls"
    ],
    "calls": [
      {
        "sdk": "Sandbox.list",
        "apiKey": "<API_KEY>",
        "metadata": {
          "role": "coordinator"
        }
      }
    ],
    "out": [
      "NAME\tSTATE\tCREATED\tMACHINE\tDELETES",
      "boss\trunning\t2026-01-02T03:04:05.000Z\tcoord-boss\tnever"
    ]
  },
  "attach": {
    "args": [
      "attach",
      "boss"
    ],
    "calls": [
      {
        "sdk": "Sandbox.list",
        "apiKey": "<API_KEY>",
        "metadata": {
          "role": "coordinator",
          "name": "boss"
        }
      }
    ],
    "out": [
      "npx --yes instabox@latest ssh coord-boss -- tmux attach -t claude"
    ]
  },
  "stop": {
    "args": [
      "stop",
      "boss"
    ],
    "calls": [
      {
        "sdk": "Sandbox.list",
        "apiKey": "<API_KEY>",
        "metadata": {
          "role": "coordinator",
          "name": "boss"
        }
      },
      {
        "sdk": "Sandbox.kill",
        "id": "m1",
        "apiKey": "<API_KEY>"
      }
    ],
    "out": [
      "Deleted coordinator boss (machine coord-boss). Its workers are deleted by its cleanup process, or by their own delete deadline (6 hours by default). Check with: npx --yes instabox@latest ls --meta purpose=cloudy-cloud"
    ]
  },
  "finish --force": {
    "args": [
      "finish",
      "--force"
    ],
    "calls": [
      {
        "http": "GET",
        "url": "https://api.instabox.sh/v1/machines?metadata=role%3Acoordinator",
        "headers": {
          "X-API-Key": "<API_KEY>"
        }
      },
      {
        "http": "DELETE",
        "url": "https://api.instabox.sh/v1/machines/m1",
        "headers": {
          "X-API-Key": "<API_KEY>",
          "Idempotency-Key": "<UUID>",
          "X-Confirm-Delete": "m1"
        }
      }
    ],
    "out": [
      "Verified: machine coord-boss (m1), coordinator boss; --force: skipped the git and worker checks.\nDeleted this machine (coord-boss)."
    ]
  }
}
